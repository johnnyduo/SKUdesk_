---
import Base from '../layouts/Base.astro';
import '../styles/landing.css';
import ShowcaseStage from '../components/hero/ShowcaseStage.astro';
import PieceFlow from '../components/landing/PieceFlow.astro';
import RoundFlow from '../components/landing/RoundFlow.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
import TrackRecord from '../components/landing/TrackRecord.astro';
import Evidence from '../components/landing/Evidence.astro';
---
<Base title="SKUdesk — One price you can trust, only for the same item.">

<header class="lp-nav"><div class="lp-wrap">
<a class="lp-logo" href="/" aria-label="SKUdesk — home"><span class="logo-mark"><svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><path d="M8 22 16 8l8 14" stroke="#CCFF00" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>SKUdesk</a>
<nav class="lp-links" aria-label="Sections"><a href="#round">How it works</a><a href="#how">Limits</a><a href="#evidence">Evidence</a></nav>
<span class="spacer"></span>
<a class="btn" href="/app/">Launch desk</a>
</div></header>

<main id="main" class="lp">

<ShowcaseStage />

<section class="ls-src" aria-label="Sources"><div class="lp-wrap">
<p class="ls-src-h">Sources · listings from Google Shopping and the stores it indexes</p>
<ul class="ls-src-list">
<li><img src="/img/sources/google-shopping.png" alt="Google Shopping" width="677" height="112" decoding="async"/></li>
<li><img src="/img/sources/lazada.png" alt="Lazada" width="427" height="112" decoding="async"/></li>
<li><img src="/img/sources/shopee.png" alt="Shopee" width="79" height="112" decoding="async"/></li>
<li><img src="/img/sources/ebay.png" alt="eBay" width="279" height="112" decoding="async"/></li>
<li><img src="/img/sources/best-buy.png" alt="Best Buy" width="163" height="112" decoding="async"/></li>
</ul>
<p class="ls-src-n">Google Shopping is the live source, with a market for Thailand where Lazada and Shopee sellers appear. SKUdesk does not scrape any store. The eBay API is wired but has not been run against the live service.</p>
</div></section>

<TrackRecord />
<RoundFlow />
<PieceFlow />
<Evidence />

</main>

<SiteFooter />
</Base>
