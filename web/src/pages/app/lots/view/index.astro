---
import Base from '../../../../layouts/Base.astro';
import Shell from '../../../../components/shell/Shell.astro';
import PageHead from '../../../../components/shell/PageHead.astro';
---
<Base title="Lot | SKUdesk" description="One product: its identical offers and price history." noindex><Shell>
<PageHead title="Lot" sub="One product, its identical offers and its price history." />
<p><a href="/app/lots/">← All lots</a></p>
<div id="view"><p class="muted">Loading…</p></div>
</Shell></Base>
<script>
  import { api, h, lineChart, money } from '../../../../lib/client.ts';
  import { priceLadder, renderAnalysis } from '../../../../lib/analysis-view.ts';
  const key = new URLSearchParams(location.search).get('key') ?? '';
  const view = document.getElementById('view')!;
  if (!/^[a-f0-9]{14}$/.test(key)) view.replaceChildren(h('div', { class: 'alert' }, 'No lot selected.'));
  else api(`/api/lots/${key}`).then(({ analysis: a, series }) => {
    document.querySelector('h1')!.textContent = a.query;
    const cur = a.currency;
    view.replaceChildren(
      h('section', { class: 'card' }, h('h2', {}, 'Price history'), h('p', { class: 'muted sm' }, 'Cheapest identical landed cost at each check. The scheduled scan adds a point every day.'),
        lineChart(series.map((p: any) => ({ t: p.t, y: p.buyLandedCents })), cur),
        h('p', { class: 'muted xs mono' }, `${series.length} point${series.length === 1 ? '' : 's'}${series.length ? ` · latest ${money(series.at(-1).buyLandedCents ?? 0, cur)}` : ''}`)),
      renderAnalysis(a));
  }).catch(() => view.replaceChildren(h('div', { class: 'alert' }, 'That lot was not found.')));
  void priceLadder;
</script>
