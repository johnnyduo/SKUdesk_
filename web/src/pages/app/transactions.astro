---
import Base from '../../layouts/Base.astro';
import Shell from '../../components/shell/Shell.astro';
import PageHead from '../../components/shell/PageHead.astro';
import Explain from '../../components/shell/Explain.astro';
---
<Base title="Decisions | SKUdesk" description="The ledger of every proposal the agent filed and what a person decided."><Shell>
<PageHead title="Decisions" sub="The ledger of every proposal and what a person decided."/>
<Explain>
This is the audit trail. The agent only <b>files proposals</b>; a person approves or rejects each one. No money moves through SKUdesk, so an approval is a recorded decision that unlocks the seller's link.
</Explain>
<section class="card" aria-labelledby="tx-h"><h2 id="tx-h">Proposals <span class="pill" id="tx-count"></span></h2>
<div class="table-wrap"><table>
<thead><tr><th>Filed</th><th>Product</th><th>Seller</th><th class="num">Landed</th><th>Source</th><th>Status</th><th>Decided</th></tr></thead>
<tbody id="rows"><tr><td colspan="7" class="muted">Loading…</td></tr></tbody></table></div>
</section>
<section class="card" aria-labelledby="ev-h"><h2 id="ev-h">Activity log</h2><div id="events"></div></section>
</Shell></Base>
<script>
  import { api, h, money, safeLink, when } from '../../lib/client.ts';
  import { feed } from '../../lib/desk.ts';
  Promise.all([api('/api/proposals'), api('/api/events')]).then(([props, events]) => {
    document.getElementById('tx-count')!.textContent = String(props.length);
    document.getElementById('rows')!.replaceChildren(...(props.length ? props.map((p: any) => h('tr', {},
      h('td', { class: 'mono xs muted nowrap' }, when(p.createdAt)),
      h('td', { class: 'tcell-t', title: p.title }, p.query),
      h('td', {}, p.status === 'approved' && p.url ? safeLink(p.url, p.seller) : p.seller),
      h('td', { class: 'num mono' }, money(p.landedCents, p.currency)),
      h('td', {}, h('span', { class: 'pill' }, p.origin === 'scan' ? 'scheduled scan' : 'user check')),
      h('td', {}, h('span', { class: `pill ${p.status === 'approved' ? 'good' : p.status === 'rejected' ? '' : 'warn'}` }, p.blockedReason && p.status === 'pending' ? 'blocked by limit' : p.status)),
      h('td', { class: 'mono xs muted nowrap' }, p.decidedAt ? when(p.decidedAt) : '—'))) : [h('tr', {}, h('td', { colspan: 7, class: 'muted' }, 'No proposals yet.'))]));
    document.getElementById('events')!.replaceChildren(events.length ? feed(events) : h('p', { class: 'muted sm' }, 'No activity yet.'));
  }).catch(() => {});
</script>
