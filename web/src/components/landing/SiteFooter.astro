---
// The landing footer: where to go and what it is built on.
const links: [string, string][] = [['The desk', '/app/'], ['Watch the agent decide', '/show/'], ['Offer market', '/market/'], ['Deploy an agent', '/app/create/'], ['Limits', '/app/agent/'], ['Proof', '/app/analytics/'], ['Pitch deck', '/deck/']];
---
<footer class="sf"><div class="lp-wrap">
<div class="sf-grid">
<div class="sf-brand">
<a class="lp-logo" href="/" aria-label="SKUdesk home"><span class="logo-mark"><svg width="16" height="16" viewBox="0 0 32 32" aria-hidden="true"><path d="M8 22 16 8l8 14" stroke="#CCFF00" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>SKUdesk</a>
<p>One price you can trust, only for the identical item.</p>
</div>
<nav class="sf-col" aria-label="Explore"><h3>Explore</h3>
{links.map(([l, h]) => <a href={h}>{l}</a>)}
</nav>
<nav class="sf-col" aria-label="Project"><h3>Project</h3>
<a href="https://github.com/johnnyduo/SKUdesk_" target="_blank" rel="noopener noreferrer">Source on GitHub ↗</a>
<a href="/app/deploy/">How it is deployed</a>
<a href="/app/integrations/">What it depends on</a>
</nav>
<div class="sf-col"><h3>Built on</h3>
<span class="muted">Gemini · Cloud Run · Firestore · Cloud Scheduler · Secret Manager</span>
</div>
</div>
<div class="sf-bar"><span>SKUdesk · Google Cloud AI Builder Cup 2026, Retail &amp; Commerce · Prices are asking prices from Google Shopping. The concept and the visual design build on the team's earlier work; the application code, data layer and evaluation were written for this competition.</span><span><a href="/app/analytics/">Proof</a></span></div>
</div></footer>

<style>
.sf{border-top:1px solid var(--line-soft);padding:var(--s12) 0 var(--s8);color:var(--mut);background:linear-gradient(180deg,rgba(14,16,15,0),rgba(14,16,15,.7))}
.sf-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:var(--s10)}
.sf-brand p{margin:var(--s4) 0 0;max-width:30ch;color:var(--mut);font-size:var(--fs-md);line-height:1.5}
.sf h3{margin:0 0 var(--s3);font-family:var(--mono);font-size:var(--fs-xs);font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--dim)}
.sf-col{display:grid;gap:var(--s1);align-content:start;justify-items:start}
.sf-col a{display:inline-flex;align-items:center;min-height:32px;color:var(--mut);text-decoration:none;font-size:var(--fs-md)}
.sf-col a:hover{color:var(--txt)}
.sf-add{min-height:44px;font-size:var(--fs-sm)}
.sf-id{margin-top:var(--s2);color:var(--dim);font-family:var(--mono);font-size:var(--fs-xs)}
.sf-note{min-height:18px;margin-top:var(--s1);color:var(--neon);font-size:var(--fs-sm)}
.sf-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:var(--s3) var(--s6);margin-top:var(--s10);padding-top:var(--s6);border-top:1px solid var(--line-soft);color:var(--dim);font-size:var(--fs-xs)}
.sf-bar a{display:inline-flex;align-items:center;min-height:var(--tap);color:var(--mut)}
@media(max-width:900px){.sf-grid{grid-template-columns:1fr 1fr;gap:var(--s8)}.sf-brand{grid-column:1/-1}}
@media(max-width:520px){.sf-grid{grid-template-columns:1fr}}
</style>
